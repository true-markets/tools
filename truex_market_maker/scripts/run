#!/usr/bin/env python3
"""
TrueX Market Maker - Unified Launcher

Usage:
    ./scripts/run [options]

Options:
    --disable-external-data       Only use local data for pricing and decision making
    --symbols                     List of symbols to make markets in
    --help                        Show this help message

Examples:
    ./scripts/run --symbols BTC-PYUSD ETH-PYUSD          # Multiple symbols

Environment Variables Required:
    TRUEX_HOST       = true markets server
    TRUEX_REST_PORT  = rest server port 
    TRUEX_WS_PORT    = websocket server port
    TRUEX_API_KEY    = true market's assigned api key 
    TRUEX_SECRET_KEY = true market's assigned api secret
    TRUEX_USER       = your mnemonic associated with a true markets client
"""

import argparse
import os
import sys

# Add the project root to Python path
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

def main():
    parser = argparse.ArgumentParser(
        description='TrueX Market Maker',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
Examples:
  ./scripts/run --symbols BTC-PYUSD
        '''
    )
    
    mode_group = parser.add_mutually_exclusive_group()
    mode_group.add_argument(
        '--disable-external-data', 
        action='store_true',
        default=False,
        help='Disable external market data'
    )
    
    parser.add_argument(
        '--symbols',
        nargs='*',
        help='Trading symbols (if not specified, uses settings.SYMBOLS)'
    )
    
    args = parser.parse_args()
    
    # Update symbols in settings if provided
    if args.symbols:
        try:
            # Import settings to update SYMBOLS
            from market_maker import settings
            settings.SYMBOLS = args.symbols
            print(f"Using symbols: {', '.join(args.symbols)}")
        except Exception as e:
            print(f"Warning: Could not update symbols: {e}")
    
    # Import market maker only after argument parsing
    from market_maker import market_maker

    # Run the market maker
    market_maker.run(args)

if __name__ == "__main__":
    main()
